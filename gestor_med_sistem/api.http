@baseUrl = http://localhost:8080/api
@token = COLE_AQUI_O_ACCESS_TOKEN_GERADO_NO_AUTH_HTTP

### 1. Criar plano
# @name createPlan
POST {{baseUrl}}/plans
Authorization: Bearer {{token}}
Content-Type: application/json

{
  "name": "Plano Profissional",
  "defaultPrice": 199.90,
  "durationDays": 30,
  "status": "ACTIVE"
}

### Listar planos
GET {{baseUrl}}/plans
Authorization: Bearer {{token}}

### Buscar plano criado
GET {{baseUrl}}/plans/{{createPlan.response.body.$.id}}
Authorization: Bearer {{token}}

### Alterar somente o status do plano
PATCH {{baseUrl}}/plans/{{createPlan.response.body.$.id}}/status
Authorization: Bearer {{token}}
Content-Type: application/json

{
  "status": "INACTIVE"
}

### Substituir os dados do plano
PUT {{baseUrl}}/plans/{{createPlan.response.body.$.id}}
Authorization: Bearer {{token}}
Content-Type: application/json

{
  "name": "Plano Profissional Plus",
  "defaultPrice": 249.90,
  "durationDays": 30,
  "status": "ACTIVE"
}

### 2. Criar módulo (execute somente se FINANCEIRO ainda não existir)
# @name createModule
POST {{baseUrl}}/modules
Authorization: Bearer {{token}}
Content-Type: application/json

{
  "code": "FINANCEIRO",
  "name": "Financeiro",
  "status": "ACTIVE"
}

### Listar módulos (use esta rota para localizar o FINANCEIRO existente)
GET {{baseUrl}}/modules
Authorization: Bearer {{token}}

### Buscar FINANCEIRO pelo código (funciona mesmo se ele foi criado anteriormente)
# @name getModule
GET {{baseUrl}}/modules/code/FINANCEIRO
Authorization: Bearer {{token}}

### Exemplo de outro módulo com código diferente
# @name createStockModule
POST {{baseUrl}}/modules
Authorization: Bearer {{token}}
Content-Type: application/json

{
  "code": "ESTOQUE",
  "name": "Controle de estoque",
  "status": "ACTIVE"
}

### 3. Vincular módulo ao plano
POST {{baseUrl}}/plan-modules
Authorization: Bearer {{token}}
Content-Type: application/json

{
  "planId": "{{createPlan.response.body.$.id}}",
  "moduleId": "{{getModule.response.body.$.id}}"
}

### Listar vínculos de planos e módulos
GET {{baseUrl}}/plan-modules
Authorization: Bearer {{token}}

### Buscar vínculo específico
GET {{baseUrl}}/plan-modules/{{createPlan.response.body.$.id}}/{{getModule.response.body.$.id}}
Authorization: Bearer {{token}}

### 4. Criar empresa
# @name createCompany
POST {{baseUrl}}/companies
Content-Type: application/json

{
  "legalName": "Clínica Saúde Ltda",
  "tradeName": "Clínica Saúde",
  "cnpj": "12345678000190",
  "status": "ACTIVE"
}

### Listar empresas
GET {{baseUrl}}/companies
Authorization: Bearer {{token}}

### Buscar empresa criada
GET {{baseUrl}}/companies/{{createCompany.response.body.$.id}}
Authorization: Bearer {{token}}

### 5. Criar configurações da empresa
POST {{baseUrl}}/company-settings
Authorization: Bearer {{token}}
Content-Type: application/json

{
  "companyId": "{{createCompany.response.body.$.id}}",
  "timezone": "America/Sao_Paulo",
  "locale": "pt-BR",
  "currency": "BRL",
  "settings": {
    "theme": "light",
    "notifications": true
  }
}

### 6. Criar assinatura
# @name createSubscription
POST {{baseUrl}}/subscriptions
Authorization: Bearer {{token}}
Content-Type: application/json

{
  "companyId": "{{createCompany.response.body.$.id}}",
  "planId": "{{createPlan.response.body.$.id}}",
  "price": 199.90,
  "startsOn": "2026-08-18",
  "expiresOn": "2026-09-17",
  "status": "ACTIVE"
}

### Listar assinaturas
GET {{baseUrl}}/subscriptions
Authorization: Bearer {{token}}

### 7. Habilitar módulo para empresa
POST {{baseUrl}}/company-modules
Authorization: Bearer {{token}}
Content-Type: application/json

{
  "companyId": "{{createCompany.response.body.$.id}}",
  "moduleId": "{{getModule.response.body.$.id}}",
  "enabled": true
}

### Desabilitar módulo para empresa
PATCH {{baseUrl}}/company-modules/{{createCompany.response.body.$.id}}/{{getModule.response.body.$.id}}
Authorization: Bearer {{token}}
Content-Type: application/json

{
  "enabled": false
}

### 8. Criar filial
# @name createBranch
POST {{baseUrl}}/branches
Authorization: Bearer {{token}}
Content-Type: application/json

{
  "companyId": "{{createCompany.response.body.$.id}}",
  "code": "MATRIZ",
  "name": "Unidade Matriz",
  "active": true
}

### Listar filiais
GET {{baseUrl}}/branches
Authorization: Bearer {{token}}

### 9. Criar usuário
# @name createUser
POST {{baseUrl}}/users
Content-Type: application/json

{
  "companyId": "{{createCompany.response.body.$.id}}",
  "type": "ADMIN",
  "name": "Administrador",
  "email": "admin@clinicasaude.com.br",
  "status": "ACTIVE",
  "password": "Admin@123"
}

### Listar usuários
GET {{baseUrl}}/users
Authorization: Bearer {{token}}

### 10. Dar permissões ao usuário
POST {{baseUrl}}/user-permissions
Authorization: Bearer {{token}}
Content-Type: application/json

{
  "userId": "{{createUser.response.body.$.id}}",
  "moduleId": "{{getModule.response.body.$.id}}",
  "canView": true,
  "canCreate": true,
  "canEdit": true,
  "canDelete": false,
  "canApprove": true,
  "canManage": false
}

### 11. Vincular usuário à filial
POST {{baseUrl}}/user-branches
Authorization: Bearer {{token}}
Content-Type: application/json

{
  "userId": "{{createUser.response.body.$.id}}",
  "branchId": "{{createBranch.response.body.$.id}}"
}

### Listar vínculos usuário/filial
GET {{baseUrl}}/user-branches
Authorization: Bearer {{token}}
